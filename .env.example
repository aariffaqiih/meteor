# Urutan fallback. Key sk-or-... untuk OpenRouter, gsk_... untuk Groq.
API_KEY_1=
API_KEY_2=
API_KEY_3=
API_KEY_4=
API_KEY_5=
API_KEY_6=

# Ubah ke true hanya jika SEMUA key Groq berasal dari akun Free Plan.
# Groq pada paket berbayar bisa menagih biaya untuk model yang sama.
GROQ_FREE_PLAN_CONFIRMED=false

# Opsional: rahasia acak minimal 32 byte untuk cookie dan tanda tangan history.
# Jika kosong, rahasia dibuat ulang saat startup dan form lama kedaluwarsa.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
METEOR_SECRET_KEY=
